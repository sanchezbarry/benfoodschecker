# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. NEVER expose to the client. (Project Settings → API → service_role / secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# ---- Resend (https://resend.com → API Keys) ----
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Must be a verified domain in Resend. For quick testing you can use:
# EMAIL_FROM="Cert Checker <onboarding@resend.dev>"
EMAIL_FROM="Cert Checker <alerts@yourdomain.com>"

# Optional. While EMAIL_FROM is still the Resend sandbox sender
# (onboarding@resend.dev), Resend will only deliver to the address the account
# was registered with — a reminder addressed to a real contact is refused.
# Set this to that one deliverable address and every reminder is routed there
# instead, with the intended recipient named in the subject and in the body.
# Remove it once you have verified a sending domain.
# EMAIL_REDIRECT_TO=you@yourdomain.com

# ---- SMTP (optional; overrides Resend when SMTP_HOST is set) ----
# Resend's shared sender (onboarding@resend.dev) will only deliver to the
# address the Resend account was registered with, and verifying a domain needs
# DNS access. Any SMTP mailbox sidesteps both and can send to anyone.
#
#   Google Workspace / Gmail   host smtp.gmail.com          port 587
#     Requires 2-Step Verification, then an App Password
#     (myaccount.google.com -> Security -> App passwords).
#     Some Workspace admins disable app passwords.
#   Microsoft 365              host smtp.office365.com      port 587
#   Brevo                      host smtp-relay.brevo.com    port 587
#   SendGrid                   host smtp.sendgrid.net       port 587  user "apikey"
#
# Set EMAIL_FROM to an address the mailbox is allowed to send as.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=someone@benfoods.com
# SMTP_PASS=your-app-password
# SMTP_SECURE=false          # true only for port 465

# ---- Cron protection ----
# Long random string. Vercel Cron / pg_cron must send this as a Bearer token.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=generate-a-long-random-string

# ---- App URL (used for the logo and the button in every reminder email) ----
# Must be absolute and publicly reachable — email clients can't resolve
# localhost. If unset, the app falls back to the production deployment
# (https://benfoodschecker.vercel.app), so the link is never broken.
NEXT_PUBLIC_APP_URL=https://benfoodschecker.vercel.app
