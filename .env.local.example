# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. NEVER expose to the client. (Project Settings → API → service_role / secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# ---- Resend (https://resend.com → API Keys) ----
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Must be a verified domain in Resend. For quick testing you can use:
# EMAIL_FROM="Cert Checker <onboarding@resend.dev>"
EMAIL_FROM="Cert Checker <alerts@yourdomain.com>"

# ---- Cron protection ----
# Long random string. Vercel Cron / pg_cron must send this as a Bearer token.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=generate-a-long-random-string

# ---- App URL (used for the logo and the button in every reminder email) ----
# Must be absolute and publicly reachable — email clients can't resolve
# localhost. If unset, the app falls back to the production deployment
# (https://benfoodschecker.vercel.app), so the link is never broken.
NEXT_PUBLIC_APP_URL=https://benfoodschecker.vercel.app
